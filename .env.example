MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/unilink?retryWrites=true&w=majority
PORT=5000
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Used only by scripts/seedAdmin.js (npm run seed:admin) to bootstrap the
# first admin account. Not read by the running server. Never commit real
# values — set these in your local .env or your host's env var settings.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_before_running
ADMIN_NAME=Admin User

# Used only by src/controllers/ai.controller.js to proxy AI Assistant
# requests through Gemini's OpenAI-compatible endpoint. Get a key at
# https://aistudio.google.com/apikey. Never commit a real value - set
# it in your local .env or your host's (Render) environment variable
# settings.
GEMINI_API_KEY=your-real-key-here

# ============================================================
# PRODUCTION EMAIL / OTP
# ============================================================
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

